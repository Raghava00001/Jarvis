# ═══════════════════════════════════════════════
#  JARVIS AI Assistant - Environment Configuration
# ═══════════════════════════════════════════════

# Required: Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Enable Gemini Live (real-time voice): 1 = on
JARVIS_USE_GEMINI_LIVE=1

# Wake word: JARVIS acts only after "Jarvis"/"Friday" (0 = respond to all speech)
JARVIS_WAKE_WORD=1
# Seconds JARVIS stays awake for follow-ups after being addressed
JARVIS_AWAKE_WINDOW=20

# Optional: Email (Gmail SMTP)
SMTP_EMAIL=
SMTP_PASSWORD=

# Optional: Weather
OPENWEATHER_API_KEY=

# Optional: News
NEWS_API_KEY=

# Optional: Knowledge Q&A (Groq, free tier). Falls back to Gemini if missing or rejected.
GROQ_API_KEY=

# Optional: second fallback for Q&A (OpenRouter, free models)
OPENROUTER_API_KEY=

# Optional: pin a Groq / OpenRouter model. By default JARVIS tries a list of current
# models and skips any the provider has retired.
# JARVIS_GROQ_MODEL=openai/gpt-oss-120b
# JARVIS_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional: console output. WARNING = only problems; DEBUG = also every error JARVIS
# recovered from, with where it happened (default INFO)
# JARVIS_LOG_LEVEL=INFO

# Optional: pin the Gemini text model (default: gemini-flash-latest, with fallbacks)
# JARVIS_GEMINI_TEXT_MODEL=gemini-2.5-flash
